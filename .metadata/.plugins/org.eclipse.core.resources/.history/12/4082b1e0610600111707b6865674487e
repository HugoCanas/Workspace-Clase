import java.awt.Image;

public class prueba extends Componente{

	private int stock;
	private String marca;
	
	public prueba(int idComponente, String descripcion, String nombre, Image imagen, int stock, int idMarca,
			double precioVenta, int stock2, String marca) {
		super(idComponente, descripcion, nombre, imagen, stock, idMarca, precioVenta);
		stock = stock2;
		this.marca = marca;
	}

	public int getStock() {
		return stock;
	}

	public void setStock(int stock) {
		this.stock = stock;
	}

	public String getMarca() {
		return marca;
	}

	public void setMarca(String marca) {
		this.marca = marca;
	}
	
	
	
}
