	private void llenarArrayNumeros(int[] arrayNumeros2) {

		int num;
		boolean repetido;

		for (int i = 0; i < arrayNumeros2.length; i++) {

			do {
				num = (int) (Math.random() * 90) + 1;
				repetido = false;

				for (int j = 0; j < i; j++) {
					if (arrayNumeros2[j] == num) {
						repetido = true;
					}
				}

			} while (repetido == true);

			arrayNumeros2[i] = num;

		}
	}

