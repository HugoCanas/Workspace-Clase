				JLabel.CENTER
			);
			labelConImagen.setVerticalTextPosition(JLabel.BOTTOM);
			labelConImagen.setHorizontalTextPosition(JLabel.CENTER);

			mensaje = labelConImagen;

		} else {
			mensaje = pregunta;
		}

		Object respuestaUsuario = JOptionPane.showInputDialog(
			this,
			mensaje,
			"Pregunta de Sostenibilidad",
			JOptionPane.QUESTION_MESSAGE,
			null,
			opciones,
			opciones[0]
		);

		if (respuestaUsuario != null && 
			respuestaUsuario.equals(respuestaCorrecta)) {

			JOptionPane.showMessageDialog(
				this,
				"¡Correcto! ¡Has ganado!",
				"Respuesta Correcta",
				JOptionPane.INFORMATION_MESSAGE
			);

		} else {
			JOptionPane.showMessageDialog(
				this,
				"Respuesta incorrecta. La respuesta era: " + respuestaCorrecta,
				"Respuesta Incorrecta",
				JOptionPane.ERROR_MESSAGE
			);
		}
	}

	private void mezclarRespuestas(String[] opciones) {
		for (int i = opciones.length - 1; i > 0; i--) {
			int j = (int)(Math.random() * (i + 1));
			String temp = opciones[i];
			opciones[i] = opciones[j];
			opciones[j] = temp;
		}
	}
}